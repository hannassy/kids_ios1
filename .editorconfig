root = true

# JavaScript files
[*.{js,jsx,ts,tsx,json}]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# React Native
[App.js]
charset = utf-8
insert_final_newline = true

[index.js]
charset = utf-8
insert_final_newline = true
